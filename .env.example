# ---------------------------------------------------------------------------
# Floe (CDC lakehouse) - shared settings (local development credentials only)
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=floe

# Source OLTP database
POSTGRES_DB=oltp
POSTGRES_SUPERUSER_PASSWORD=postgres
APP_DB_USER=app
APP_DB_PASSWORD=app
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=debezium
CATALOG_DB_USER=iceberg
CATALOG_DB_PASSWORD=iceberg

# Object storage (MinIO, S3 compatible)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
AWS_REGION=us-east-1
WAREHOUSE_BUCKET=warehouse

# Airflow web UI / REST API login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# TPC-H scale loaded into PostgreSQL (tiny | sf1). sf1 = 150k customers, 1.5M orders
TPCH_SCALE=sf1

# Spark streaming ingestion tuning
TRIGGER_INTERVAL=10 seconds
MAX_OFFSETS_PER_TRIGGER=100000

# OLTP workload generator (operations per second)
WORKLOAD_OPS_PER_SEC=100

# Grafana login (anonymous viewers are allowed)
GRAFANA_ADMIN_PASSWORD=admin
